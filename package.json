{
  "name": "agent-lens",
  "displayName": "Agent Lens",
  "description": "Observe local coding agent activity in VS Code.",
  "version": "0.1.0",
  "publisher": "salehshakib",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/salehshakib/agent-lens.git"
  },
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./dist/host/extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentLens.activity",
          "title": "Agent Lens",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentLens.activity": [
        {
          "id": "agentLens.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "agentLens.openUsage", "title": "Open Usage and Limits", "category": "Agent Lens" },
      { "command": "agentLens.openTasks", "title": "Open Background Tasks", "category": "Agent Lens" },
      { "command": "agentLens.showAccounts", "title": "Show Accounts", "category": "Agent Lens" },
      { "command": "agentLens.accounts.openStatus", "title": "Open Official Account Status Terminal", "category": "Agent Lens" },
      { "command": "agentLens.relay.enable", "title": "Enable Claude Limits Relay", "category": "Agent Lens" },
      { "command": "agentLens.relay.remove", "title": "Remove Claude Limits Relay", "category": "Agent Lens" }
    ],
    "configuration": {
      "title": "Agent Lens",
      "properties": {
        "agentLens.agents": {
          "type": "object",
          "scope": "machine",
          "default": {},
          "markdownDescription": "Local source settings keyed by `claude-code` or `codex`. Each can set `enabled`, an observation-only `logRoot`, and additional `profiles` with `id`, `label`, and `home`."
        },
        "agentLens.privateDisplay": {
          "type": "boolean",
          "scope": "machine",
          "default": false,
          "markdownDescription": "Hide prompts, commands, command output, diffs and transcript links in Agent Lens views."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir dist/test && node --test \"dist/test/test/*.test.js\"",
    "profile": "node --expose-gc scripts/profile.mjs",
    "inspect:vsix": "node scripts/inspect-vsix.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.146.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
